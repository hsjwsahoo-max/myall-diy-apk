# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Server-side HMAC secret used to sign authenticated session tokens and audit logs.
SESSION_SECRET=""

# SQLITE_DB_PATH: Path to persistent server-side SQLite database file.
SQLITE_DB_PATH="./data/nexustrade.sqlite"

# BINANCE_READONLY_API_KEY & BINANCE_READONLY_API_SECRET:
# Optional server-side Read-Only Exchange API credentials (MUST NOT have withdrawal permissions).
# Used by /api/exchange/sync to read genuine exchange balances and historical trade/deposit records.
BINANCE_READONLY_API_KEY=""
BINANCE_READONLY_API_SECRET=""

# EXCHANGE_TRADING_API_ENABLED & EXCHANGE_WITHDRAWAL_API_ENABLED:
# Explicit flags indicating whether authorized live exchange order routing / custodial withdrawals are enabled.
EXCHANGE_TRADING_API_ENABLED="false"
EXCHANGE_WITHDRAWAL_API_ENABLED="false"

# VITE_WALLETCONNECT_PROJECT_ID: Optional WalletConnect v2 Cloud Project ID
# Required for QR-code relay pairing with mobile wallets outside in-app wallet browsers.
VITE_WALLETCONNECT_PROJECT_ID=""
